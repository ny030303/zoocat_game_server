# ── 배포(prod) 환경에서만 채운다 ─────────────────────────────
# 이 파일을 .env 로 복사해서 값을 채운다:  cp .env.example .env
#
# 로컬 개발은 .env 없이 동작한다.
#   - docker compose up      → compose 가 MONGO_URI 를 mongo 컨테이너로 주입
#   - npm run dev (호스트)    → src/config/db.ts 의 localhost fallback 사용

# MongoDB Atlas 연결 문자열 (Atlas > Connect > Drivers 에서 복사)
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/zoocat?retryWrites=true&w=majority

DB_NAME=zoocat
PORT=3000
NODE_ENV=production

# 리버스 프록시(Caddy)가 HTTPS 인증서를 발급받을 도메인.
# 이 도메인의 DNS A 레코드가 배포 박스 공인 IP 를 가리켜야 한다.
DOMAIN=game.example.com
